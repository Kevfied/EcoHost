{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EcoHost",
  "version": "0.1.6",
  "identifier": "com.ecohost.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EcoHost",
        "width": 760,
        "height": 540,
        "minWidth": 600,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/ecohost-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
